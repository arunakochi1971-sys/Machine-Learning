      "source": [
        "<a href=\"https://colab.research.google.com/github/arunakochi1971-sys/Machine-Learning/blob/main/exp6.pynb\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "J0IiH2svRjQ3"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "from sklearn.datasets import fetch_20newsgroups\n",
        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "from sklearn.naive_bayes import MultinomialNB, BernoulliNB\n",
        "from sklearn.metrics import classification_report, accuracy_score, f1_score\n",
        "import pandas as pd"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "categories = [\n",
        "'comp.graphics',\n",
        "'rec.sport.hockey',\n",
        "'sci.med',\n",
        "'talk.politics.mideast'\n",
        "]\n",
        "\n",
        "print(\"Fetching dataset...\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "dOcxfBa3SFqp",
        "outputId": "f93f4daa-6778-4bab-8654-9355be203d09"
      },
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Fetching dataset...\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "train_data = fetch_20newsgroups(\n",
        "subset='train',\n",
        "categories=categories,\n",
        "remove=('headers', 'footers', 'quotes')\n",
        ")"
      ],
      "metadata": {
        "id": "rgWQcBiOSJe5"
      },
      "execution_count": 9,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "test_data = fetch_20newsgroups(\n",
        "subset='test',\n",
        "categories=categories,\n",
        "remove=('headers', 'footers', 'quotes')\n",
        ")"
      ],
      "metadata": {
        "id": "yMdwjfHjSSuZ"
      },
      "execution_count": 11,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "y_train = train_data.target\n",
        "y_test = test_data.target\n",
        "\n",
        "print(f\"Loaded {len(train_data.data)} training documents \"\n",
        "f\"and {len(test_data.data)} test documents.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "eLco6m1nSlyh",
        "outputId": "58219445-93eb-49b0-c169-1ab25ef9c57b"
      },
      "execution_count": 13,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Loaded 2342 training documents and 1560 test documents.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "mnb_vectorizer = CountVectorizer(\n",
        "stop_words='english',\n",
        "max_features=10000\n",
        ")"
      ],
      "metadata": {
        "id": "1ZjjMCKESqlp"
      },
      "execution_count": 15,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "X_train_counts = mnb_vectorizer.fit_transform(train_data.data)\n",
        "X_test_counts = mnb_vectorizer.transform(test_data.data)"
      ],
      "metadata": {
        "id": "gHlCV6m3S0Z5"
      },
      "execution_count": 16,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "bnb_vectorizer = CountVectorizer(\n",
        "stop_words='english',\n",
        "max_features=10000,\n",
        "binary=True\n",
        ")\n",
        "\n",
        "X_train_binary = bnb_vectorizer.fit_transform(train_data.data)\n",
        "X_test_binary = bnb_vectorizer.transform(test_data.data)\n",
        "\n",
        "print(\"Vectorization strategies initialized and applied.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "7fxCvsTGTGCL",
        "outputId": "d5069f5a-4ba0-40d7-96a7-a586f8eddd4f"
      },
      "execution_count": 18,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Vectorization strategies initialized and applied.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "mnb = MultinomialNB(alpha=1.0)\n",
        "mnb.fit(X_train_counts, y_train)\n",
        "\n",
        "y_pred_mnb = mnb.predict(X_test_counts)"
      ],
      "metadata": {
        "id": "Xs2_cYHDTIy7"
      },
      "execution_count": 19,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "bnb = BernoulliNB(alpha=1.0)\n",
        "bnb.fit(X_train_binary, y_train)\n",
        "\n",
        "y_pred_bnb = bnb.predict(X_test_binary)"
      ],
      "metadata": {
        "id": "Qk0dmCqsVTzd"
      },
      "execution_count": 20,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "results = {\n",
        "\"Multinomial NB\": [\n",
        "accuracy_score(y_test, y_pred_mnb),\n",
        "\n",
        "f1_score(y_test, y_pred_mnb, average='macro')\n",
        "],\n",
        "\"Bernoulli NB\": [\n",
        "accuracy_score(y_test, y_pred_bnb),\n",
        "f1_score(y_test, y_pred_bnb, average='macro')\n",
        "]\n",
        "}\n",
        "\n",
        "df_results = pd.DataFrame(\n",
        "results,\n",
        "index=[\"Accuracy\", \"Macro F1-Score\"]\n",
        ")\n",
        "\n",
        "print(df_results.round(4))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "GkpGwgbOVVuF",
        "outputId": "befe66d1-7395-4d75-ccc3-efc3d5a50a7d"
      },
      "execution_count": 22,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "                Multinomial NB  Bernoulli NB\n",
            "Accuracy                0.9167        0.7513\n",
            "Macro F1-Score          0.9170        0.7606\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"=\" * 25 + \" Multinomial Classification Report \" + \"=\" * 25)\n",
        "print(classification_report(\n",
        "y_test,\n",
        "y_pred_mnb,\n",
        "target_names=categories\n",
        "))\n",
        "\n",
        "print(\"=\" * 26 + \" Bernoulli Classification Report \" + \"=\" * 26)\n",
        "print(classification_report(\n",
        "y_test,\n",
        "y_pred_bnb,\n",
        "target_names=categories\n",
        "))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4zsID1fEVZSF",
        "outputId": "69ae2ffd-9fcc-4a89-df29-d876c6f6943d"
      },
      "execution_count": 24,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "========================= Multinomial Classification Report =========================\n",
            "                       precision    recall  f1-score   support\n",
            "\n",
            "        comp.graphics       0.95      0.92      0.93       389\n",
            "     rec.sport.hockey       0.92      0.93      0.92       399\n",
            "              sci.med       0.88      0.89      0.88       396\n",
            "talk.politics.mideast       0.93      0.93      0.93       376\n",
            "\n",
